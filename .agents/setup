#!/usr/bin/env bash
set -euo pipefail

cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.."
SECONDS=0

# Match .github/workflows/ci.yml, including the bundled npm version.
node_version=22.12.0
if [[ "$(node --version 2>/dev/null || true)" != "v${node_version}" ]]; then
  echo "Installing Node ${node_version}"
  case "$(uname -m)" in
    x86_64) arch=x64 ;;
    aarch64) arch=arm64 ;;
    *) echo "Unsupported architecture: $(uname -m)" >&2; exit 1 ;;
  esac
  archive="node-v${node_version}-linux-${arch}.tar.xz"
  download_dir="$(mktemp -d)"
  trap 'rm -rf -- "$download_dir"' EXIT
  curl --fail --silent --show-error --location --retry 3 \
    "https://nodejs.org/dist/v${node_version}/${archive}" -o "$download_dir/$archive"
  curl --fail --silent --show-error --location --retry 3 \
    "https://nodejs.org/dist/v${node_version}/SHASUMS256.txt" -o "$download_dir/SHASUMS256.txt"
  (cd "$download_dir"; grep "  ${archive}$" SHASUMS256.txt | sha256sum --check -)
  sudo tar -xJf "$download_dir/$archive" -C /usr/local --strip-components=1
  hash -r
fi
echo "Toolchain ready in ${SECONDS}s: $(node --version), npm $(npm --version)"

# npm ci validates the lockfile and reuses npm's snapshotted download cache.
echo "Installing locked dependencies"
install_started=$SECONDS
npm ci --prefer-offline --no-audit --no-fund --include=dev
echo "Dependencies ready in $((SECONDS - install_started))s; setup completed in ${SECONDS}s"
